{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Osmium development format 0.1",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "distribution_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution_version", "canonicalization", "package", "files"],
      "properties": {
        "distribution_version": {"const": "0.1"},
        "canonicalization": {"const": "osmium-json-0.1"},
        "package": {"$ref": "#/$defs/manifest"},
        "files": {
          "type": "object",
          "maxProperties": 4095,
          "propertyNames": {"$ref": "#/$defs/path"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size", "sha256"],
            "properties": {
              "size": {"type": "integer", "minimum": 0, "maximum": 4194304},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$",
        "maxLength": 200
      },
      "additionalProperties": true,
      "maxProperties": 64
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$",
      "maxLength": 200
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\\\:\\u0000-\\u001f/]+(/[^\\\\:\\u0000-\\u001f/]+)*$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9-]*$",
          "maxLength": 200
        },
        "package_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/capability"
              },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/capability"
              },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            }
          },
          "required": [
            "required",
            "optional"
          ],
          "additionalProperties": false
        },
        "entities": {
          "type": "object",
          "properties": {
            "concepts": {
              "$ref": "#/$defs/path"
            },
            "objectives": {
              "$ref": "#/$defs/path"
            },
            "curricula": {
              "$ref": "#/$defs/path"
            },
            "resources": {
              "$ref": "#/$defs/path"
            },
            "assessments": {
              "$ref": "#/$defs/path"
            }
          },
          "required": [
            "concepts",
            "objectives",
            "curricula",
            "resources",
            "assessments"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "required": [
        "schema_version",
        "package_id",
        "package_version",
        "title",
        "language",
        "capabilities",
        "entities"
      ],
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "required": [
        "id",
        "title",
        "requires"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "concept": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "required": [
        "id",
        "concept",
        "description"
      ],
      "additionalProperties": false
    },
    "curriculum": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "required": [
        "id",
        "title",
        "objectives"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "markdown"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "teaches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "path",
        "teaches"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 32
            },
            "measures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "stimulus": {
              "type": "object",
              "properties": {
                "markdown": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "markdown"
              ],
              "additionalProperties": false
            },
            "feedback": {
              "type": "object",
              "properties": {
                "markdown": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "markdown"
              ],
              "additionalProperties": false
            },
            "response": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "single_select"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    },
                    "required": [
                      "id",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2,
                  "maxItems": 100,
                  "uniqueItems": true
                }
              },
              "required": [
                "type",
                "options"
              ],
              "additionalProperties": false
            },
            "evaluation": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "exact"
                },
                "answer": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "type",
                "answer"
              ],
              "additionalProperties": false
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "required": [
            "id",
            "revision",
            "measures",
            "stimulus",
            "feedback",
            "response",
            "evaluation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 32
            },
            "measures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "stimulus": {
              "type": "object",
              "properties": {
                "markdown": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "markdown"
              ],
              "additionalProperties": false
            },
            "feedback": {
              "type": "object",
              "properties": {
                "markdown": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "markdown"
              ],
              "additionalProperties": false
            },
            "response": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "evaluation": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "exact"
                },
                "answer": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "answer"
              ],
              "additionalProperties": false
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          },
          "required": [
            "id",
            "revision",
            "measures",
            "stimulus",
            "feedback",
            "response",
            "evaluation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objective"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "curricula": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/curriculum"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "learning_event": {
      "type": "object",
      "properties": {
        "event_schema_version": {
          "const": "0.1"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9-]*$",
          "maxLength": 200
        },
        "package_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 64
        },
        "package_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assessment_id": {
          "$ref": "#/$defs/id"
        },
        "assessment_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 32
        },
        "assessment_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "assessment_snapshot": {
          "$ref": "#/$defs/assessment"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "score": {
          "enum": [
            0,
            1
          ]
        },
        "evaluator": {
          "type": "object",
          "properties": {
            "id": {
              "const": "org.osmium.exact.v1"
            },
            "version": {
              "const": "1"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hints_used": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "event_schema_version",
        "event_id",
        "device_id",
        "request_id",
        "package_id",
        "package_version",
        "package_digest",
        "assessment_id",
        "assessment_revision",
        "assessment_hash",
        "objective_ids",
        "assessment_snapshot",
        "response",
        "score",
        "evaluator",
        "timestamp",
        "duration_ms",
        "hints_used"
      ],
      "additionalProperties": false
    }
  }
}
