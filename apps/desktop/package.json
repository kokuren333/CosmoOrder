{
  "name": "osmium-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Osmium desktop reader and learning UI (Tauri 2 + React + TypeScript)",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings src tests e2e",
