    "cognitive_level": "application",
    "stimulus": {
      "markdown": "1から5までの同じ大きさの区画があるルーレットを1回回します。偶数が出る事象の確率と、余事象の確率の組として正しいものはどれですか？"
    },
    "response": {
      "type": "single_select",
      "options": [
        {
          "id": "a",
          "text": "偶数は 2/5、余事象は 3/5"
        },
        {
          "id": "b",
          "text": "偶数は 1/2、余事象も 1/2"
        },
        {
          "id": "c",
          "text": "偶数は 2/5、余事象も 2/5"
        }
      ]
    },
    "evaluation": {
      "type": "exact",
      "answer": "a"
    },
    "feedback": {
      "markdown": "結果は5通りで同様に確からしく、偶数は2通りです。余事象は $1-2/5=3/5$ です。"
    },
    "evidence_reference_ids": [
      "openstax-intro-stats-probability"
    ]
  },
